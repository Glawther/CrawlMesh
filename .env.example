CRAWLMESH_APP_NAME=CrawlMesh
CRAWLMESH_MODE=standalone
CRAWLMESH_HOST=127.0.0.1
CRAWLMESH_PORT=8090
CRAWLMESH_WORKERS=4
CRAWLMESH_RATE_LIMIT_RPS=2.0
CRAWLMESH_TIMEOUT=15.0
CRAWLMESH_MAX_RETRIES=3
CRAWLMESH_REDIS_URL=redis://localhost:6379/0
CRAWLMESH_POSTGRES_DSN=postgresql://crawlmesh:crawlmesh@localhost:5432/crawlmesh
